# Application example; contains no usable credentials.
# Prepare a NEW local development database and its dedicated account first.
# development enables schema synchronization. Never target shared data.
# This file is separate from .env.test.local.example and port 3308 test settings.
NODE_ENV=development
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=stockflow_local
DB_USERNAME=stockflow_local
# Supply your own local development DB account password.
DB_PASSWORD=

# Generate a separate random signing key locally; never commit its value.
JWT_SECRET=
# Numeric lifetime in seconds.
JWT_EXPIRES_IN=3600
