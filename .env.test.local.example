# Example only; no actual credentials. Do not use development/production values.
# Copying or loading this file never grants approval to start a DB or run tests.
# After separate approval, create ignored .env.test.local and provide unique passwords.
NODE_ENV=test
RUN_DB_TESTS=0
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=3308
TEST_DB_DATABASE=stockflow_test
TEST_DB_USERNAME=stockflow_test
TEST_DB_PASSWORD=
TEST_DB_ROOT_PASSWORD=

# RUN_DB_TESTS must be explicitly set to 1 only for approved integration execution.
# The test helper does not load .env files or fall back to DB_* variables.
# Compose consumes the two TEST_DB_*PASSWORD values; root is not a test client account.
